{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amacs.accelanalysis.com/schemas/decision-template.schema.json",
  "title": "AMACS Decision Template",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_template_id",
    "preferred_label",
    "description",
    "factor_ids",
    "weighting_required",
    "status",
    "version_introduced"
  ],
  "properties": {
    "decision_template_id": {
      "type": "string",
      "pattern": "^AMACS-[A-Z]{3,5}-\\d{6}$"
    },
    "preferred_label": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1000
    },
    "factor_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^AMACS-[A-Z]{3,5}-\\d{6}$"
      }
    },
    "weighting_required": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "active",
        "deprecated",
        "suspended",
        "retired"
      ]
    },
    "version_introduced": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    }
  }
}
