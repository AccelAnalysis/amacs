{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amacs.accelanalysis.com/schemas/decision-factor.schema.json",
  "title": "AMACS Decision Factor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_factor_id",
    "preferred_label",
    "method",
    "definition",
    "status",
    "version_introduced"
  ],
  "properties": {
    "decision_factor_id": {
      "type": "string",
      "pattern": "^AMACS-[A-Z]{3,5}-\\d{6}$"
    },
    "preferred_label": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160
    },
    "method": {
      "type": "string",
      "enum": [
        "gate",
        "scored",
        "ranking",
        "formula",
        "narrative"
      ]
    },
    "definition": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1000
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "active",
        "deprecated",
        "suspended",
        "retired"
      ]
    },
    "version_introduced": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    }
  }
}
