{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amacs.accelanalysis.com/schemas/domain-seed.schema.json",
  "title": "AMACS Domain Seed",
  "type": "object",
  "additionalProperties": false,
  "required": ["domain_id", "label", "definition", "families"],
  "properties": {
    "domain_id": {"type": "string", "pattern": "^AMACS-DOM-\\d{6}$"},
    "label": {"type": "string", "minLength": 2, "maxLength": 160},
    "definition": {"type": "string", "minLength": 20, "maxLength": 1000},
    "version_introduced": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "source_origin": {"type": "string", "enum": ["original_amacs", "user_proposal", "external_crosswalk"]},
    "status": {"type": "string", "enum": ["proposed", "active", "deprecated", "suspended", "retired"]},
    "editorial_maturity": {"type": "string", "enum": ["draft", "reviewed", "approved"]},
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family_id", "label", "capabilities"],
        "properties": {
          "family_id": {"type": "string", "pattern": "^AMACS-FAM-\\d{6}$"},
          "label": {"type": "string", "minLength": 2, "maxLength": 160},
          "definition": {"type": "string", "minLength": 20, "maxLength": 1000},
          "status": {"type": "string", "enum": ["proposed", "active", "deprecated", "suspended", "retired"]},
          "editorial_maturity": {"type": "string", "enum": ["draft", "reviewed", "approved"]},
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "array",
                  "prefixItems": [
                    {"type": "string", "pattern": "^AMACS-CAP-\\d{6}$"},
                    {"type": "string", "minLength": 2, "maxLength": 160}
                  ],
                  "minItems": 2,
                  "maxItems": 2
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["capability_id", "label"],
                  "properties": {
                    "capability_id": {"type": "string", "pattern": "^AMACS-CAP-\\d{6}$"},
                    "label": {"type": "string", "minLength": 2, "maxLength": 160},
                    "definition": {"type": "string", "minLength": 20, "maxLength": 1000},
                    "status": {"type": "string", "enum": ["proposed", "active", "deprecated", "suspended", "retired"]},
                    "editorial_maturity": {"type": "string", "enum": ["draft", "reviewed", "approved"]}
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
