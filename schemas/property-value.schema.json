{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amacs.accelanalysis.com/schemas/property-value.schema.json",
  "title": "AMACS Property Value",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "property_value_id",
    "property_id",
    "value",
    "label",
    "status",
    "version_introduced"
  ],
  "properties": {
    "property_value_id": {
      "type": "string",
      "pattern": "^AMACS-[A-Z]{3,5}-\\d{6}$"
    },
    "property_id": {
      "type": "string",
      "pattern": "^AMACS-[A-Z]{3,5}-\\d{6}$"
    },
    "value": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "label": {
      "type": "string",
      "minLength": 2,
      "maxLength": 200
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "active",
        "deprecated",
        "suspended",
        "retired"
      ]
    },
    "version_introduced": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    }
  }
}
