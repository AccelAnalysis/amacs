{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amacs.accelanalysis.com/schemas/concept-property.schema.json",
  "title": "AMACS Concept Property",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "concept_property_id",
    "concept_id",
    "property_id",
    "inherit_to_descendants",
    "status",
    "version_introduced"
  ],
  "properties": {
    "concept_property_id": {
      "type": "string",
      "pattern": "^AMACS-[A-Z]{3,5}-\\d{6}$"
    },
    "concept_id": {
      "type": "string",
      "pattern": "^AMACS-[A-Z]{3,5}-\\d{6}$"
    },
    "property_id": {
      "type": "string",
      "pattern": "^AMACS-[A-Z]{3,5}-\\d{6}$"
    },
    "inherit_to_descendants": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "active",
        "deprecated",
        "suspended",
        "retired"
      ]
    },
    "version_introduced": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    }
  }
}
