{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amacs.accelanalysis.com/schemas/requirement-type.schema.json",
  "title": "AMACS Requirement Type",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requirement_type_id",
    "code",
    "preferred_label",
    "definition",
    "match_dimension",
    "allowed_decision_treatments",
    "team_coverage_allowed",
    "status",
    "version_introduced"
  ],
  "properties": {
    "requirement_type_id": {
      "type": "string",
      "pattern": "^AMACS-[A-Z]{3,5}-\\d{6}$"
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z0-9_]+$"
    },
    "preferred_label": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160
    },
    "definition": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1200
    },
    "match_dimension": {
      "type": "string",
      "enum": [
        "capability_concept",
        "credential",
        "experience",
        "geography",
        "capacity",
        "delivery_condition",
        "evidence",
        "technical_specification",
        "commercial",
        "site_location"
      ]
    },
    "allowed_decision_treatments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "gate_only",
          "scored_only",
          "gate_and_scored_depth",
          "informational_only"
        ]
      }
    },
    "team_coverage_allowed": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "active",
        "deprecated",
        "suspended",
        "retired"
      ]
    },
    "version_introduced": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    }
  }
}
