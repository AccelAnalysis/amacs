{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amacs.accelanalysis.com/schemas/governance-profile.schema.json",
  "title": "AMACS Governance Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "governance_profile_id",
    "code",
    "preferred_label",
    "definition",
    "submission_system",
    "confidentiality_modes",
    "requires_authorized_issuer",
    "supports_internal_approval",
    "supports_sealed_responses",
    "supports_negotiation",
    "requires_evaluation_lock",
    "legal_authority_boundary",
    "status",
    "version_introduced"
  ],
  "properties": {
    "governance_profile_id": {
      "type": "string",
      "pattern": "^AMACS-[A-Z]{3,5}-\\d{6}$"
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z0-9_]+$"
    },
    "preferred_label": {
      "type": "string",
      "minLength": 2,
      "maxLength": 180
    },
    "definition": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1200
    },
    "submission_system": {
      "type": "string",
      "enum": [
        "rfxchange",
        "external",
        "configurable"
      ]
    },
    "confidentiality_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "public",
          "restricted",
          "invited",
          "confidential_project"
        ]
      }
    },
    "requires_authorized_issuer": {
      "type": "boolean"
    },
    "supports_internal_approval": {
      "type": "boolean"
    },
    "supports_sealed_responses": {
      "type": "boolean"
    },
    "supports_negotiation": {
      "type": "boolean"
    },
    "requires_evaluation_lock": {
      "type": "boolean"
    },
    "legal_authority_boundary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1600
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "active",
        "deprecated",
        "suspended",
        "retired"
      ]
    },
    "version_introduced": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    }
  }
}
