{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amacs.accelanalysis.com/schemas/credential.schema.json",
  "title": "AMACS Credential Type",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "credential_id",
    "preferred_label",
    "credential_type",
    "definition",
    "verification_required",
    "status",
    "version_introduced"
  ],
  "properties": {
    "credential_id": {
      "type": "string",
      "pattern": "^AMACS-[A-Z]{3,5}-\\d{6}$"
    },
    "preferred_label": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160
    },
    "credential_type": {
      "type": "string",
      "enum": [
        "identity",
        "license",
        "certification",
        "insurance",
        "bonding",
        "registration",
        "identifier",
        "evidence",
        "experience",
        "financial",
        "property",
        "utility"
      ]
    },
    "definition": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1000
    },
    "verification_required": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "active",
        "deprecated",
        "suspended",
        "retired"
      ]
    },
    "version_introduced": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    }
  }
}
