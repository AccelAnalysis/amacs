{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amacs.accelanalysis.com/schemas/alias-seed.schema.json",
  "title": "AMACS Alias Seed",
  "type": "object",
  "additionalProperties": false,
  "required": ["version_introduced", "aliases"],
  "properties": {
    "version_introduced": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "aliases": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {"type": "string", "pattern": "^AMACS-CAP-\\d{6}$"},
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "prefixItems": [
                {"type": "string", "pattern": "^AMACS-ALS-\\d{6}$"},
                {"type": "string", "minLength": 1, "maxLength": 200},
                {"type": "string", "enum": ["synonym", "abbreviation", "acronym", "former_label", "common_misspelling", "industry_term", "search_term"]},
                {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"},
                {"type": "string", "minLength": 2, "maxLength": 12}
              ],
              "minItems": 5,
              "maxItems": 5
            }
          }
        ],
        "minItems": 2,
        "maxItems": 2
      }
    }
  }
}
