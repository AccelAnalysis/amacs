{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amacs.accelanalysis.com/schemas/external-classification-crosswalk.schema.json",
  "title": "External Classification Crosswalk",
  "description": "A governed mapping from an external classification entry to an AMACS capability. A crosswalk is not an AMACS alias and is not evidence that an organization possesses the target capability.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "crosswalk_id",
    "source_scheme",
    "source_entry",
    "target_concept_id",
    "mapping_relation",
    "mapping_status",
    "confidence",
    "rationale",
    "provenance",
    "status",
    "version_introduced",
    "not_for_alias_import"
  ],
  "properties": {
    "crosswalk_id": {"type": "string", "minLength": 1, "maxLength": 220},
    "source_scheme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme_id", "title", "edition", "publisher", "source_field"],
      "properties": {
        "scheme_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "edition": {"type": "string", "minLength": 1, "maxLength": 80},
        "publisher": {"type": "string", "minLength": 1, "maxLength": 300},
        "source_field": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "source_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 160},
        "label": {"type": "string", "minLength": 1, "maxLength": 500},
        "description": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "target_concept_id": {"type": "string", "pattern": "^AMACS-CAP-\\d{6}$"},
    "mapping_relation": {
      "type": "string",
      "enum": ["exact_match", "close_match", "broad_match", "narrow_match", "related_match"]
    },
    "mapping_status": {"type": "string", "enum": ["candidate", "reviewed", "approved", "rejected"]},
    "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
    "rationale": {"type": "string", "minLength": 10, "maxLength": 2000},
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_type", "title", "url", "publisher", "accessed_at"],
        "properties": {
          "source_type": {
            "type": "string",
            "enum": ["external_classification", "official_standard", "regulatory_metadata_mirror", "other_public_source"]
          },
          "title": {"type": "string", "minLength": 1, "maxLength": 500},
          "url": {"type": "string", "format": "uri"},
          "publisher": {"type": "string", "minLength": 1, "maxLength": 300},
          "accessed_at": {"type": "string", "format": "date-time"},
          "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "status": {"type": "string", "enum": ["draft", "active", "deprecated"]},
    "version_introduced": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "not_for_alias_import": {"const": true}
  }
}
